    -- Отдельная область локальных переменных: не расходует лимит boot-функции.
    extras.BuildEnvironment = function()
        local rgb = Color3.fromRGB
        local presets = {
            Sunset = { time = 18.1, bright = 2.1, ambient = rgb(103, 78, 102), outdoor = rgb(151, 117, 110),
                tint = rgb(255, 222, 196), fog = rgb(226, 172, 146), density = 0.27, haze = 1.4, saturation = 0.08 },
            Night = { time = 0.5, bright = 1.2, ambient = rgb(45, 49, 76), outdoor = rgb(76, 85, 116),
                tint = rgb(201, 217, 255), fog = rgb(91, 112, 155), density = 0.22, haze = 0.7, saturation = -0.12 },
            Morning = { time = 7.2, bright = 2.5, ambient = rgb(121, 115, 108), outdoor = rgb(161, 156, 143),
                tint = rgb(255, 243, 220), fog = rgb(225, 223, 208), density = 0.25, haze = 1.1, saturation = 0.02 },
            Horror = { time = 1.5, bright = 0.65, ambient = rgb(40, 44, 43), outdoor = rgb(65, 74, 70),
                tint = rgb(195, 212, 202), fog = rgb(74, 91, 85), density = 0.43, haze = 2.5, saturation = -0.45 },
        }
        local atmosphereSaved, skySaved = {}, {}
        local grade, bloom, addedAtmosphere, addedSky
        local atmosphericActive = false
        local effects, effectTime = {}, 0
        local faces = { { "Bk", "Back", "bk" }, { "Dn", "Down", "dn" }, { "Ft", "Front", "ft" },
            { "Lf", "Left", "lf" }, { "Rt", "Right", "rt" }, { "Up", "Up", "up" } }

        -- Six faces from Roblox's official indoor-lighting sample.
        -- https://create.roblox.com/docs/tutorials/use-case-tutorials/lighting/enhance-indoor-environments
        local sunsetIds = { Bk = "162001887", Dn = "161998893", Ft = "162001897",
            Lf = "162001904", Rt = "162001919", Up = "162001926" }
        local skyLoadState, skyLoadGeneration = "idle", 0
        local function preloadSky()
            if skyLoadState ~= "idle" then return end
            skyLoadState = "loading"
            skyLoadGeneration = skyLoadGeneration + 1
            local generation = skyLoadGeneration
            task.spawn(function()
                local failed = false
                local ok = pcall(function()
                    local provider = game:GetService("ContentProvider")
                    local assets = {}
                    for _, face in ipairs(faces) do assets[#assets + 1] = "rbxassetid://" .. sunsetIds[face[1]] end
                    provider:PreloadAsync(assets, function(_, status)
                        if status ~= Enum.AssetFetchStatus.Success then failed = true end
                    end)
                end)
                if not alive or generation ~= skyLoadGeneration then return end
                skyLoadState = ok and not failed and "ready" or "failed"
                if skyLoadState == "failed" and Settings.CustomSky and Settings.SkyPreset == "Sunset" then
                    notify("Небо «Закат» не загрузилось. Временно показано стандартное небо.")
                end
            end)
        end

        -- Каждое свойство хранит исходное и последнее записанное значение.
        -- Чужие изменения после нашего последнего кадра не откатываются.
        local function write(saved, object, key, value)
            local record = saved[object]
            if not record then record = {}; saved[object] = record end
            if not record[key] then record[key] = { original = object[key] } end
            if object[key] ~= value then object[key] = value end
            record[key].last = object[key]
        end
        local function restore(saved)
            for object, properties in pairs(saved) do
                if object.Parent or object == Lighting then
                    for key, value in pairs(properties) do
                        protected("environment-restore-" .. key, function()
                            if object[key] == value.last then object[key] = value.original end
                        end)
                    end
                end
                saved[object] = nil
            end
        end
        local function remove(object) if object then object:Destroy() end end
        extras.StopAtmosphere = function()
            restore(atmosphereSaved)
            remove(grade); remove(bloom); remove(addedAtmosphere)
            grade, bloom, addedAtmosphere, atmosphericActive = nil, nil, nil, false
        end
        local function stopSky()
            restore(skySaved); remove(addedSky); addedSky = nil
        end
        local function stopParticles(key)
            local effect = effects[key]
            if effect then effect.folder:Destroy(); effects[key] = nil end
        end
        stopEnvironment = function()
            extras.StopAtmosphere(); stopSky()
            stopParticles("Character"); stopParticles("Ambient")
        end
        local function blend(saved, object, key, target, alpha)
            local current = object[key]
            write(saved, object, key, typeof(target) == "Color3" and current:Lerp(target, alpha)
                or current + (target - current) * alpha)
        end
        local function atmosphereFrame(dt)
            if not Settings.AtmosphereEnabled then
                if atmosphericActive then extras.StopAtmosphere() end
                return
            end
            if not atmosphericActive then
                restoreWorld()
                Settings.WorldEnabled = false; toggleRefreshers.WorldEnabled(true)
                atmosphericActive = true
                grade = create("ColorCorrectionEffect", { Name = "NexusAtmosphereGrade", Enabled = true,
                    TintColor = rgb(255, 255, 255), Contrast = 0, Saturation = 0, Brightness = 0 }, Lighting)
                bloom = create("BloomEffect", { Name = "NexusAtmosphereBloom", Enabled = true,
                    Intensity = 0, Size = 24, Threshold = 1.5 }, Lighting)
            end
            local preset = presets[Settings.AtmospherePreset] or presets.Sunset
            local alpha, strength = 1 - math.exp(-dt * 2), Settings.AtmosphereStrength / 100
            -- Часы переходят кратчайшим путём через полночь.
            local clock = Lighting.ClockTime
            write(atmosphereSaved, Lighting, "ClockTime", (clock + ((preset.time - clock + 12) % 24 - 12) * alpha) % 24)
            blend(atmosphereSaved, Lighting, "Brightness", preset.bright, alpha)
            blend(atmosphereSaved, Lighting, "Ambient", preset.ambient, alpha)
            blend(atmosphereSaved, Lighting, "OutdoorAmbient", preset.outdoor, alpha)
            grade.TintColor = grade.TintColor:Lerp(rgb(255, 255, 255):Lerp(preset.tint, strength), alpha)
            grade.Saturation = grade.Saturation + (preset.saturation * strength - grade.Saturation) * alpha
            grade.Contrast = grade.Contrast + (0.08 * strength - grade.Contrast) * alpha
            bloom.Intensity = bloom.Intensity + (0.18 * strength - bloom.Intensity) * alpha
            local found = false
            for _, object in ipairs(Lighting:GetChildren()) do
                if object:IsA("Atmosphere") then
                    found = true
                    blend(atmosphereSaved, object, "Density", preset.density * strength, alpha)
                    blend(atmosphereSaved, object, "Haze", preset.haze * strength, alpha)
                    blend(atmosphereSaved, object, "Color", preset.fog, alpha)
                end
            end
            if not found then
                addedAtmosphere = create("Atmosphere", { Name = "NexusAtmosphere", Density = 0,
                    Haze = 0, Color = preset.fog }, Lighting)
            end
        end
        local function skyFrame()
            if not Settings.CustomSky then if next(skySaved) or addedSky then stopSky() end; return end
            if Settings.SkyPreset == "Sunset" then preloadSky() end
            local found = false
            for _, sky in ipairs(Lighting:GetChildren()) do
                if sky:IsA("Sky") then
                    found = true
                    for _, face in ipairs(faces) do
                        local id = ""
                        if Settings.SkyPreset == "Sunset" and skyLoadState == "ready" then id = sunsetIds[face[1]]
                        elseif Settings.SkyPreset == "Legacy" then id = Settings["Sky" .. face[1]] end
                        write(skySaved, sky, "Skybox" .. face[1], id == "" and
                            ("rbxasset://textures/sky/sky512_" .. face[3] .. ".tex") or ("rbxassetid://" .. id))
                    end
                    write(skySaved, sky, "CelestialBodiesShown", true)
                    write(skySaved, sky, "StarCount", Settings.SkyStars)
                    write(skySaved, sky, "SunAngularSize", Settings.SkySun)
                    write(skySaved, sky, "MoonAngularSize", Settings.SkyMoon)
                end
            end
            if not found then addedSky = create("Sky", { Name = "NexusSky" }, Lighting) end
        end
        local function makeEmitter(part, mode, rate)
            local sparkle = mode == "Sparks" or mode == "Orbit"
            local size = Settings.ParticleSize / 100
            return create("ParticleEmitter", {
                Name = "NexusParticleEmitter", Enabled = true,
                Texture = mode == "Snow" and "rbxasset://textures/particles/smoke_main.dds"
                    or "rbxasset://textures/particles/sparkles_main.dds",
                Rate = rate, Lifetime = NumberRange.new(mode == "Sparks" and 0.4 or 1.3, mode == "Sparks" and 1 or 2.5),
                Speed = NumberRange.new(mode == "Snow" and 0.8 or 0.15, mode == "Snow" and 1.6 or (sparkle and 2 or 0.6)),
                SpreadAngle = Vector2.new(180, 180), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-35, 35),
                Color = ColorSequence.new(Settings.ParticleColor),
                Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.3),
                    NumberSequenceKeypoint.new(0.2, size), NumberSequenceKeypoint.new(1, 0) }),
                Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.15, 0.15), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) }),
                LightEmission = mode == "Snow" and 0.2 or 0.85, LightInfluence = 0,
                Acceleration = Vector3.new(0, mode == "Snow" and -1.2 or (mode == "Sparks" and 2 or 0.2), 0),
                Drag = 0.5, LockedToPart = false, VelocityInheritance = 0, ZOffset = 0,
            }, part)
        end
        local function particleFrame(key, center, identity, dt)
            if not center then stopParticles(key); return end
            local mode = Settings.ParticleMode
            local signature = table.concat({ mode, Settings.ParticleDensity, Settings.ParticleRadius,
                Settings.ParticleSize, toHex(Settings.ParticleColor) }, ":")
            local effect = effects[key]
            if effect and (effect.signature ~= signature or effect.identity ~= identity
                or (center - effect.center).Magnitude > 80) then stopParticles(key); effect = nil end
            if not effect then
                effect = { folder = create("Folder", { Name = "Nexus" .. key .. "Particles" }, worldFolder),
                    signature = signature, identity = identity, parts = {}, center = center }
                effects[key] = effect -- register before construction so failures can clean up
                local count = mode == "Orbit" and key == "Character" and 4 or 1
                for i = 1, count do
                    local radius = key == "Ambient" and 28 or Settings.ParticleRadius * 2
                    local part = create("Part", { Name = "NexusParticleCarrier", Transparency = 1,
                        Size = count == 1 and Vector3.new(radius, key == "Ambient" and 18 or 5, radius) or Vector3.new(0.1, 0.1, 0.1),
                        Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false,
                        CFrame = CFrame.new(center) }, effect.folder)
                    table.insert(effect.parts, part)
                    makeEmitter(part, mode, Settings.ParticleDensity / count)
                end
            end
            effect.center = center
            for i, part in ipairs(effect.parts) do
                local offset = Vector3.new(0, key == "Ambient" and 4 or 0, 0)
                if #effect.parts > 1 then
                    local angle = effectTime * Settings.ParticleSpeed / 25 + (i - 1) * math.pi / 2
                    offset = Vector3.new(math.cos(angle) * Settings.ParticleRadius,
                        math.sin(angle * 1.5) * 1.6, math.sin(angle) * Settings.ParticleRadius)
                end
                part.CFrame = CFrame.new(center + offset)
            end
        end
        extras.EnvironmentFrame = function(camera, dt)
