            Text = "", ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 14, TextColor3 = Theme.Text }, dialog)
        corner(hex, 5)
        stroke(hex)
        local copy = button(dialog, "Копировать", UDim2.fromOffset(166, 230), UDim2.fromOffset(102, 28), Theme.Hover)
        copy.Name = "PickerCopy"
        copy.TextSize = 11
        local target, h, s, v = nil, 0, 0, 1
        local function draw()
            if not target then return end
            local color = Settings[target.key]
            preview.BackgroundColor3 = color
            saturation.Color = ColorSequence.new(white, Color3.fromHSV(h, 1, 1))
            cursor.Position = UDim2.fromScale(s, 1 - v)
            hueCursor.Position = UDim2.fromScale(h, 0.5)
            hueCursor.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            hex.Text, copy.Text = toHex(color), "Копировать"
        end
        extras.ActivePaletteKey = function() return target and target.key end
        extras.SyncPalette = function(key)
            if not target or target.key ~= key then return end
            h, s, v = Settings[key]:ToHSV()
            draw()
        end
        extras.ClosePalette = function()
            activeSlider = nil
            if UserInputService:GetFocusedTextBox() == hex then hex:ReleaseFocus() end
            target = nil
            shade.Visible, extras.PaletteOpen = false, false
        end
        extras.OpenPalette = function(key, label, refresh, callback, anchor)
            if extras.CloseTelegram then extras.CloseTelegram() end
            activeSlider, dragWindow = nil, nil
            target = { key = key, refresh = refresh, callback = callback }
            local scale = math.max(uiScale.Scale, 0.1)
            local pos = (anchor.AbsolutePosition - panel.AbsolutePosition) / scale
            local available = panel.AbsoluteSize / scale
            local x = pos.X + anchor.AbsoluteSize.X / scale + 8
            if x + 280 > available.X then x = pos.X - 288 end
            dialog.Position = UDim2.fromOffset(math.clamp(x, 4, math.max(4, available.X - 284)), math.clamp(pos.Y, 4, math.max(4, available.Y - 274)))
            title.Text = label
            extras.SyncPalette(key)
            shade.Visible, extras.PaletteOpen = true, true
        end
        local function commit(color)
            if not target then return end
            Settings[target.key] = color
            target.refresh(true) -- Retain hue/saturation at black and grey while dragging.
            draw()
            if target.callback then target.callback() end
        end
        local function beginDrag(control, mode, input)
            if not target then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local function update(x, y)
                if not target or not shade.Visible then return end
                local fraction = math.clamp((x - control.AbsolutePosition.X) / math.max(control.AbsoluteSize.X, 1), 0, 1)
                if mode == "hue" then h = fraction else
                    s = fraction
                    v = 1 - math.clamp((y - control.AbsolutePosition.Y) / math.max(control.AbsoluteSize.Y, 1), 0, 1)
                end
                commit(Color3.fromHSV(h, s, v))
            end
            activeSlider = { input = input, update = update }
            update(input.Position.X, input.Position.Y)
        end
        connect(sv.InputBegan, "picker-sv", function(input) beginDrag(sv, "sv", input) end)
        connect(hue.InputBegan, "picker-hue", function(input) beginDrag(hue, "hue", input) end)
        connect(hex.FocusLost, "picker-hex", function()
            if not target then return end
            local color = parseHex(hex.Text)
            if color then h, s, v = color:ToHSV(); commit(color) else
                hex.Text = toHex(Settings[target.key])
                notify("Цвет: введи шесть HEX-цифр, например #32A852.")
            end
        end)
        connect(copy.Activated, "picker-copy", function()
            if not target then return end
            local clipboard = type(setclipboard) == "function" and setclipboard or environment.setclipboard
            local ok, result = false, nil
            if type(clipboard) == "function" then ok, result = pcall(clipboard, toHex(Settings[target.key])) end
            if ok and result ~= false then copy.Text = "Скопировано" else
                hex:CaptureFocus()
                hex.SelectionStart, hex.CursorPosition = 1, #hex.Text + 1
                notify("Выделен HEX-код: нажми Ctrl+C для копирования.")
            end
        end)
        connect(close.Activated, "picker-close", extras.ClosePalette)
        connect(shade.Activated, "picker-outside", extras.ClosePalette)
    end
