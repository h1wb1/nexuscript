    -- Bounding box вычисляется по восьми углам частей тела без аксессуаров.
    -- При пересечении ближней плоскости рамка скрывается, чтобы не растягивать её.
    local cornerSigns = {
        Vector3.new(-1,-1,-1), Vector3.new(-1,-1,1), Vector3.new(-1,1,-1), Vector3.new(-1,1,1),
        Vector3.new(1,-1,-1), Vector3.new(1,-1,1), Vector3.new(1,1,-1), Vector3.new(1,1,1),
    }
    local function bounds(record, camera)
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        local count = 0
        for _, part in ipairs(record.parts) do
            if part.Parent == record.character then
                local half = part.Size * 0.5
                for _, sign in ipairs(cornerSigns) do
                    local world = (record.pose[part] or part.CFrame):PointToWorldSpace(Vector3.new(half.X * sign.X, half.Y * sign.Y, half.Z * sign.Z))
                    local projected = camera:WorldToViewportPoint(world)
                    if projected.Z <= 0.1 then return nil end
                    minX, minY = math.min(minX, projected.X), math.min(minY, projected.Y)
                    maxX, maxY = math.max(maxX, projected.X), math.max(maxY, projected.Y)
                    count = count + 1
                end
            end
        end
        local viewport = camera.ViewportSize
        if count == 0 or maxX < 0 or minX > viewport.X or maxY < 0 or minY > viewport.Y then return nil end
        return minX, minY, maxX, maxY
    end

    local function updateArrow(record, camera, distance)
        local relative = camera.CFrame:PointToObjectSpace(record.rootWorld)
        local direction = Vector2.new(relative.X, -relative.Y)
        -- Для цели точно за спиной выбираем низ экрана вместо деления на ноль.
        if direction.Magnitude < 0.001 then direction = Vector2.new(0, 1) end
        direction = direction.Unit
        local center = camera.ViewportSize / 2
        local half = Vector2.new(math.max(10, center.X - 38), math.max(10, center.Y - 48))
        local radius = math.min(half.X / math.max(math.abs(direction.X), 0.0001), half.Y / math.max(math.abs(direction.Y), 0.0001))
        local tip = center + direction * radius
        local base = tip - direction * 12
        local sideways = Vector2.new(-direction.Y, direction.X) * 6
        drawLine(record.arrowA, base + sideways, tip, 2)
        drawLine(record.arrowB, base - sideways, tip, 2)
        local labelPoint = tip - direction * 29
        record.arrowText.Position = UDim2.fromOffset(labelPoint.X, labelPoint.Y)
        record.arrowText.Visible = Settings.Distance
        record.arrowText.Text = tostring(math.floor(distance + 0.5))
    end
    local function updateRecord(player, record, camera, dt, now)
        local character, humanoid, rootPart = enemyData(player, not Settings.ESPTeammates)
        if not Settings.ESP or not character or (camera.CFrame.Position - rootPart.Position).Magnitude > Settings.MaxDistance then
            hideRecord(record)
            return
        end
        record.boxStroke.Color = Settings.BoxColor
        record.tracer.BackgroundColor3 = Settings.BoxColor
        record.arrowA.BackgroundColor3, record.arrowB.BackgroundColor3 = Settings.BoxColor, Settings.BoxColor
        record.name.TextColor3, record.arrowText.TextColor3 = Settings.TextColor, Settings.TextColor
        if record.character ~= character or now >= record.nextRefresh then
            if record.character ~= character then
                record.pose, record.rootWorld, record.hp = {}, nil, nil
                record.nextLabel = 0
            end
            record.character, record.parts = character, {}
            record.nextRefresh = now + 1
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and not isProxy(child) then table.insert(record.parts, child) end
            end
            for part in pairs(record.pose) do if part.Parent ~= character then record.pose[part] = nil end end
        end
        local alpha = 1 - math.exp(-Settings.ESPSmoothing * math.min(dt, 0.1))
        local teleported = record.rootWorld and (record.rootWorld - rootPart.Position).Magnitude > 30
        if not record.rootWorld or teleported then
            record.rootWorld, record.pose = rootPart.Position, {}
        else
            record.rootWorld = record.rootWorld:Lerp(rootPart.Position, alpha)
        end
        local rootScreen, rootVisible = camera:WorldToViewportPoint(record.rootWorld)
        local distance = (camera.CFrame.Position - record.rootWorld).Magnitude
        record.arrowA.Visible, record.arrowB.Visible, record.arrowText.Visible = false, false, false
        record.group.Visible = true
        if not rootVisible or rootScreen.Z <= 0.1 then
            record.body.Visible, record.wasOnscreen = false, false
            if Settings.Arrows then updateArrow(record, camera, distance) end
            return
        end
        -- Сглаживание в мировом пространстве. Затем проекция текущей камерой:
        -- повороты камеры не тянут за собой старые экранные координаты рамок.
        for _, part in ipairs(record.parts) do
            if part.Parent == character then
                local old = record.wasOnscreen and record.pose[part]
                record.pose[part] = old and old:Lerp(part.CFrame, alpha) or part.CFrame
            end
        end
        record.wasOnscreen = true
        local x1, y1, x2, y2 = bounds(record, camera)
        record.body.Visible = x1 ~= nil
        if not x1 then return end
        local width, height, centerX = x2 - x1, y2 - y1, (x1 + x2) / 2
        record.box.Visible = Settings.Boxes
        record.box.Position, record.box.Size = UDim2.fromOffset(x1, y1), UDim2.fromOffset(width, height)
        record.name.Visible = Settings.Names
        record.name.Position = UDim2.fromOffset(centerX, y1 - 3)
        local hp = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        record.hp = record.hp and record.hp + (hp - record.hp) * alpha or hp
        local hpColor = Settings.HealthColor
        record.hpBack.Visible, record.hpText.Visible = Settings.Health, Settings.Health or Settings.Distance
        record.hpBack.Position, record.hpBack.Size = UDim2.fromOffset(x1 - 6, y1), UDim2.fromOffset(3, height)
        record.hpFill.Size, record.hpFill.BackgroundColor3 = UDim2.fromScale(1, record.hp), hpColor
        record.hpText.Position, record.hpText.TextColor3 = UDim2.fromOffset(centerX, y2 + 3), Settings.TextColor
        if now >= record.nextLabel then
            record.nextLabel = now + 0.1
            record.name.Text = player.DisplayName == player.Name and player.Name or (player.DisplayName .. " @" .. player.Name)
            local label = Settings.Health and (tostring(math.ceil(humanoid.Health)) .. " / " .. tostring(math.ceil(humanoid.MaxHealth)) .. " HP") or ""
            if Settings.Distance then label = label .. (Settings.Health and "  ·  " or "") .. tostring(math.floor(distance + 0.5)) .. " studs" end
            record.hpText.Text = label
        end
        record.tracer.Visible = false
        if Settings.Tracers then
            local point, visible = camera:WorldToViewportPoint(record.rootWorld)
            if visible and point.Z > 0 then drawLine(record.tracer, camera.ViewportSize / 2, Vector2.new(point.X, point.Y), 1) end
        end
        for index, pair in ipairs(bonePairs) do
            local line = record.bones[index]
            line.BackgroundColor3 = Settings.BoneColor
            line.Visible = false
            if Settings.Bones then
                local a, b = character:FindFirstChild(pair[1]), character:FindFirstChild(pair[2])
                if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                    local from, fromVisible = camera:WorldToViewportPoint((record.pose[a] or a.CFrame).Position)
                    local to, toVisible = camera:WorldToViewportPoint((record.pose[b] or b.CFrame).Position)
                    if fromVisible and toVisible and from.Z > 0.1 and to.Z > 0.1 then
                        drawLine(line, Vector2.new(from.X, from.Y), Vector2.new(to.X, to.Y), 1)
                    end
                end
            end
        end
    end

    -- Aimbot: выбор ближайшей к центру экрана цели внутри круга FOV.
    -- Камера обновляется после стандартного CameraModule, без замены CameraType.
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local targetName, lockedPlayer = nil, nil
    local function aimFrame(camera, deltaTime)
        local previousTarget = lockedPlayer
        targetName = nil
        lockedPlayer = nil
        local rageMode = Settings.AutoAim
        local aiming = (Settings.Aim and rightMouseHeld) or rageMode
        if not aiming or Settings.Freecam or introActive or menuOpen then return end
        if not windowFocused or UserInputService:GetFocusedTextBox() or GuiService.MenuIsOpen then return end
        local ownCharacter = localPlayer.Character
        local ownHumanoid = ownCharacter and ownCharacter:FindFirstChildOfClass("Humanoid")
        if not ownHumanoid or ownHumanoid.Health <= 0 then return end
        if camera.CameraType == Enum.CameraType.Scriptable then return end
        local radius, targetPart = Settings.FOV, Settings.TargetPart
        local prediction, predictionMs = Settings.Prediction, Settings.PredictionMs
        local visibleCheck, teamCheck = Settings.VisibleCheck, Settings.TeamCheck
        if rageMode then
            radius, targetPart = Settings.RageFOV, Settings.RageTargetPart
            prediction, predictionMs = Settings.RagePrediction, Settings.RagePredictionMs
            visibleCheck, teamCheck = Settings.RageVisibleCheck, Settings.RageTeamCheck
        end
        rayParams.FilterDescendantsInstances = rayIgnore(ownCharacter, camera, true)
        local center, bestScore, bestPart, bestPlayer, bestPosition = camera.ViewportSize / 2, math.huge, nil, nil, nil
        local bestPixelDistance
        for _, player in ipairs(Players:GetPlayers()) do
            protected("aim-candidate", function()
                local character, humanoid = enemyData(player, teamCheck)
                if not character then return end
                local part = character:FindFirstChild(targetPart) or character:FindFirstChild("HumanoidRootPart")
                if not part or not part:IsA("BasePart") then return end
                local aimPosition = part.Position
                if prediction then
                    local velocity = part.AssemblyLinearVelocity
                    -- Ограничение защищает от скачков скорости после телепортации.
                    if velocity.Magnitude > 350 then velocity = velocity.Unit * 350 end
                    aimPosition = aimPosition + velocity * (predictionMs / 1000)
                end
                local projected, visible = camera:WorldToViewportPoint(aimPosition)
                if not visible or projected.Z <= 0.1 then return end
                local distance = (Vector2.new(projected.X, projected.Y) - center).Magnitude
                if distance > radius then return end
                local score = distance
                if rageMode then
                    if Settings.RagePriority == "Distance" then score = (part.Position - camera.CFrame.Position).Magnitude
                    elseif Settings.RagePriority == "Health" then score = humanoid.Health end
                    if Settings.RageHoldTarget and player == previousTarget then score = -1 end
                elseif player == previousTarget then
                    score = score * 0.9
                end
                if score >= bestScore then return end
                if visibleCheck then
                    local origin = camera.CFrame.Position
                    local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
                    if hit and not hit.Instance:IsDescendantOf(character) then return end
                    if prediction then
                        local predictedHit = workspace:Raycast(origin, aimPosition - origin, rayParams)
                        if predictedHit and not predictedHit.Instance:IsDescendantOf(character) then return end
                    end
                end
                bestScore, bestPart, bestPlayer, bestPosition = score, part, player, aimPosition
                bestPixelDistance = distance
            end)
        end
        if bestPart and bestPart.Parent then
            local origin = camera.CFrame.Position
            local offset = bestPosition - origin
            -- Почти вертикальные направления оставляем CameraModule, избегая вырожденного lookAt.
            if offset.Magnitude > 0.01 and math.abs(offset.Unit.Y) < 0.9999 then
                local desired = CFrame.lookAt(origin, bestPosition)
                if rageMode then
                    camera.CFrame = desired
                elseif bestPixelDistance > Settings.LegitDeadzone then
                    local alpha = 1 - math.exp(-Settings.Smoothness * math.min(deltaTime, 0.1))
                    camera.CFrame = camera.CFrame:Lerp(desired, alpha)
                end
                targetName = bestPlayer.DisplayName
            end
        end
        lockedPlayer = bestPlayer
    end

    -- Triggerbot использует настоящий raycast: преграда блокирует выстрел.
    -- Клик запускается лишь после непрерывного удержания цели на прицеле.
    local triggerParams = RaycastParams.new()
    triggerParams.FilterType = Enum.RaycastFilterType.Exclude
    triggerParams.IgnoreWater = true
    local proxyVisibilityParams = RaycastParams.new()
    proxyVisibilityParams.FilterType = Enum.RaycastFilterType.Exclude
    proxyVisibilityParams.IgnoreWater = true
    local triggerTarget, triggerElapsed, shotCooldown, previousFireMode = nil, 0, 0, nil
    extras.ResetFire = function()
        triggerTarget, triggerElapsed, shotCooldown, previousFireMode = nil, 0, 0, nil
        targetName, lockedPlayer = nil, nil
    end
    local function triggerFrame(camera, dt)
        -- Auto Shoot имеет приоритет, но не изменяет сохранённое Settings.Trigger.
        -- Auto Aim не участвует ни в блокировке UI, ни в выборе режима стрельбы.
        local fireMode = Settings.AutoShot and "AutoShot" or Settings.Trigger and "Trigger" or nil
        if fireMode ~= previousFireMode then
            previousFireMode, triggerTarget, triggerElapsed, shotCooldown = fireMode, nil, 0, 0
        end
        shotCooldown = math.max(0, shotCooldown - dt)
        if not fireMode or not clickMouse or Settings.Freecam or introActive or menuOpen or not windowFocused
            or GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() then
            triggerTarget, triggerElapsed = nil, 0
            return
        end
        local ownCharacter = localPlayer.Character
        local humanoid = ownCharacter and ownCharacter:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then triggerTarget, triggerElapsed = nil, 0; return end
        triggerParams.FilterDescendantsInstances = rayIgnore(ownCharacter, camera, false)
        local viewport = camera.ViewportSize
        local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
        local hit = workspace:Raycast(ray.Origin, ray.Direction * 10000, triggerParams)
        local player, ancestor = nil, hit and hit.Instance
        while ancestor and ancestor ~= workspace do
            if ancestor:IsA("Model") then player = Players:GetPlayerFromCharacter(ancestor); if player then break end end
            ancestor = ancestor.Parent
        end
        local checkTeam = Settings.TeamCheck
        if fireMode == "AutoShot" then checkTeam = Settings.RageTeamCheck end
        local character = player and enemyData(player, checkTeam)
        if not character then triggerTarget, triggerElapsed = nil, 0; return end
        if fireMode == "AutoShot" and Settings.AutoAim and player ~= lockedPlayer then
            triggerTarget, triggerElapsed = nil, 0
            return
        end
        -- Proxy может выступать из-за стены. Проверяем реальное тело отдельным
        -- лучом, исключив все proxy, иначе область могла бы маскировать преграду.
        if hit and isProxy(hit.Instance) then
            local targetPart = fireMode == "AutoShot" and Settings.RageTargetPart or Settings.TargetPart
            local body = character:FindFirstChild(targetPart) or character:FindFirstChild("HumanoidRootPart")
            if not body then triggerTarget, triggerElapsed = nil, 0; return end
            proxyVisibilityParams.FilterDescendantsInstances = rayIgnore(ownCharacter, camera, true)
            local obstruction = workspace:Raycast(camera.CFrame.Position, body.Position - camera.CFrame.Position, proxyVisibilityParams)
            if obstruction and not obstruction.Instance:IsDescendantOf(character) then
                triggerTarget, triggerElapsed = nil, 0
                return
            end
        end
        if triggerTarget ~= player then triggerTarget, triggerElapsed = player, 0 end
        triggerElapsed = triggerElapsed + math.min(dt, 0.1)
        local delay = (fireMode == "AutoShot" and Settings.AutoShotDelay or Settings.TriggerDelay) / 1000
        local ready = fireMode == "AutoShot" and Settings.RageImmediateShot or triggerElapsed >= delay
        if ready and shotCooldown <= 0 then
            local ok = protected("trigger-click", clickMouse)
            triggerElapsed, shotCooldown = 0, delay
            if not ok then
                Settings[fireMode] = false
                toggleRefreshers[fireMode](true)
                refreshAutoShotLock()
                notify((fireMode == "AutoShot" and "Auto Shoot" or "Triggerbot") .. " выключен: исполнитель не смог выполнить клик.")
            end
        end
    end

    -- Карточка использует уже выбранную цель; повторный поиск игроков не нужен.
    extras.BuildTargetCard = function()
        local card = create("CanvasGroup", { Name = "TargetCard", AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(280, 104),
            BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.08, BorderSizePixel = 0,
            GroupTransparency = 1, Visible = false, Active = false, ZIndex = 50 }, root)
        corner(card, 9)
        stroke(card).Transparency = 0.25
        local mode = text(card, "", UDim2.fromOffset(14, 10), UDim2.new(1, -28, 0, 14), 9, Theme.Accent)
        mode.Name = "TargetCardMode"
        local name = text(card, "", UDim2.fromOffset(14, 28), UDim2.new(1, -28, 0, 23), 16, Theme.Text, true)
        name.Name = "TargetCardName"
        local stats = text(card, "", UDim2.fromOffset(14, 56), UDim2.new(1, -28, 0, 18), 11, Theme.Muted)
        stats.Name = "TargetCardStats"
        local track = create("Frame", { Position = UDim2.fromOffset(14, 84), Size = UDim2.new(1, -28, 0, 5),
            BackgroundColor3 = Theme.Line, BorderSizePixel = 0 }, card)
        corner(track, 3)
        local fill = create("Frame", { Name = "TargetCardHealth", Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Settings.HealthColor, BorderSizePixel = 0 }, track)
        corner(fill, 3)
        local shownPlayer, fraction = nil, 1
        extras.HideTargetCard = function()
            if activeTweens[card] then activeTweens[card]:Cancel() end
            card.Visible, card.GroupTransparency = false, 1
            shownPlayer = nil
        end
        extras.TargetCardFrame = function(camera, dt)
            if not Settings.TargetCard or introActive or menuOpen or not windowFocused or GuiService.MenuIsOpen
                or not camera or not lockedPlayer or not (Settings.AutoAim or Settings.Aim) then
                if card.Visible then extras.HideTargetCard() end
                return
            end
            local checkTeam = Settings.TeamCheck
            if Settings.AutoAim then checkTeam = Settings.RageTeamCheck end
            local character, humanoid, body = enemyData(lockedPlayer, checkTeam)
            if not character then extras.HideTargetCard(); return end
            local maximum = math.max(1, humanoid.MaxHealth)
            local health = math.clamp(humanoid.Health, 0, maximum)
            local desired = health / maximum
            if shownPlayer ~= lockedPlayer then
                shownPlayer, fraction = lockedPlayer, desired
                card.Visible, card.GroupTransparency = true, 1
                tween(card, { GroupTransparency = 0 }, 0.18)
            end
            fraction = fraction + (desired - fraction) * (1 - math.exp(-14 * math.clamp(dt, 0, 0.1)))
            fill.Size, fill.BackgroundColor3 = UDim2.fromScale(fraction, 1), Settings.HealthColor
            name.Text, name.TextColor3 = lockedPlayer.DisplayName, Settings.TextColor
            mode.Text = (Settings.AutoAim and "RAGE" or "LEGIT") .. "  /  @" .. lockedPlayer.Name
            stats.Text = string.format("%d / %d HP  ·  %d studs", math.floor(health + 0.5), math.floor(maximum + 0.5),
                math.floor((body.Position - camera.CFrame.Position).Magnitude + 0.5))
            card.Size = UDim2.fromOffset(math.max(160, math.min(280, camera.ViewportSize.X - 36)), 104)
        end
    end
    extras.BuildTargetCard()
    extras.BuildTargetCard = nil

    -- Два упорядоченных render-callback: сначала управление камерой,
    -- затем ESP после стандартных Camera/Character callback. Лимита 30 FPS нет.
    -- BindToRenderStep — управляемая по приоритету привязка к render-фазе.
    local layoutTimer, worldTimer = 0, 0
    local previousViewport = viewportSize()
    local previousCamera
    local function cameraFrame(deltaTime)
        local camera = workspace.CurrentCamera
        if not camera then return end
        local radius = Settings.AutoAim and Settings.RageFOV or Settings.FOV
        displayedFOV = displayedFOV + (radius - displayedFOV) * (1 - math.exp(-20 * math.min(deltaTime, 0.1)))
        if Settings.Freecam then
            targetName, lockedPlayer = nil, nil
            local ok = protected("freecam-frame", freecamFrame, camera, deltaTime)
            if not ok then
                Settings.Freecam = false
                protected("freecam-failure-cleanup", stopFreecam)
                toggleRefreshers.Freecam(true)
                notify("Freecam выключен после ошибки. Состояние камеры восстановлено.")
            end
        else
            protected("aim-frame", aimFrame, camera, deltaTime)
        end
    end
    local function frame(deltaTime)
        protected("watermark", extras.WatermarkFrame, deltaTime)
        local camera = workspace.CurrentCamera
        protected("target-card", extras.TargetCardFrame, camera, deltaTime)
        local environmentOK = protected("environment", extras.EnvironmentFrame, camera, deltaTime)
        if not environmentOK then
            Settings.AtmosphereEnabled, Settings.CustomSky = false, false
            Settings.AmbientParticles, Settings.CharacterParticles = false, false
            protected("environment-recovery", stopEnvironment)
            for _, key in ipairs({ "AtmosphereEnabled", "CustomSky", "AmbientParticles", "CharacterParticles" }) do
                toggleRefreshers[key](true)
            end
            notify("Визуальные эффекты выключены после ошибки. Подробности — в консоли.")
        end
        if not camera then
            fovCircle.Visible, crosshair.Visible = false, false
            for _, record in pairs(records) do hideRecord(record) end
            protected("camera-missing-proxy", restoreHitboxes)
            protected("camera-missing-chams", restoreChams)
            protected("camera-missing-weather", stopWeather)
            return
        end
        if camera ~= previousCamera then
            previousCamera = camera
            for _, record in pairs(records) do hideRecord(record) end
        end
        local showFOV = Settings.Aim and Settings.ShowFOV
        if Settings.AutoAim then showFOV = Settings.RageShowFOV end
        fovCircle.Visible = showFOV and not Settings.Freecam and not introActive
        fovCircle.Size = UDim2.fromOffset(displayedFOV * 2, displayedFOV * 2)
        fovStroke.Color = targetName and Theme.Text or Theme.Accent
        protected("crosshair", drawCrosshair, camera)
        protected("proxy-frame", updateHitboxes)
        protected("chams-frame", updateChams)
        protected("trigger", triggerFrame, camera, deltaTime)
        local weatherOK = protected("weather", extras.WeatherFrame, camera, deltaTime)
        if not weatherOK then
            Settings.Weather = false
            protected("weather-recovery", stopWeather)
            toggleRefreshers.Weather(true)
            notify("Погода выключена после ошибки. Подробности — в консоли.")
        end
        layoutTimer, worldTimer = layoutTimer + deltaTime, worldTimer + deltaTime
        if Settings.ESP then
            local now = os.clock()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= localPlayer then
                    local record = records[player]
                    if not record then
                        local ok, created = protected("esp-create", makeRecord, player)
                        if ok then record = created else protected("esp-create-cleanup", removeRecord, player) end
                    end
                    if record then
                        local ok = protected("esp-player", updateRecord, player, record, camera, deltaTime, now)
                        if not ok then protected("esp-recovery", removeRecord, player) end
                    end
                end
            end
        else
            for _, record in pairs(records) do hideRecord(record) end
        end
        if worldTimer >= 0.2 then
            worldTimer = 0
            if Settings.WorldEnabled and Settings.WorldKeep then protected("world-refresh", applyWorld) end
        end
        if layoutTimer >= 0.25 then
            layoutTimer = 0
            local viewport = camera.ViewportSize
            if viewport ~= previousViewport then previousViewport = viewport; fitWindow() end
            if pendingCharacter then
                if pendingCharacter ~= localPlayer.Character or not pendingCharacter.Parent then
                    pendingCharacter = nil
                elseif pendingCharacter:FindFirstChildOfClass("Humanoid") then
                    protected("respawn-movement", applyMovement)
                    pendingCharacter = nil
                end
            end
        end
    end
    -- Конфиги — данные JSON, никогда не исполняемый Lua. Проверка всего профиля
    -- завершается до изменения Settings; допустимые диапазоны берутся из ползунков.
    do
        local binds = section(configs.right, "KEYBINDS")
        local keys = { "Aim", "AutoAim", "AutoShot", "Trigger", "ESP", "Chams", "Hitbox", "Fly", "Noclip", "Freecam", "SpeedEnabled", "JumpEnabled", "Bhop", "WorldEnabled", "Weather", "AtmosphereEnabled", "CustomSky", "CharacterParticles", "AmbientParticles", "Crosshair" }
        local buttons = {}
        local function refresh()
            for _, key in ipairs(keys) do buttons[key].Text = extras.BindingKey == key and "Нажми…" or (Settings["Bind_" .. key] == "" and "—" or Settings["Bind_" .. key]) end
        end
        for _, key in ipairs(keys) do
            Settings["Bind_" .. key], extras.Defaults["Bind_" .. key] = "", ""
            buttons[key] = action(binds, key, "Нажми: назначить · Esc: отмена · Backspace: убрать", "—", function()
                extras.BindingKey = key
                refresh()
            end)
            buttons[key].Name = key .. "BindButton"
            extras.Refresh["Bind_" .. key] = refresh
        end
        extras.CancelBinding = function() extras.BindingKey = nil; refresh() end
        extras.HandleBind = function(input, processed)
            if UserInputService:GetFocusedTextBox() then return false end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return false end
            local name = input.KeyCode.Name
            if extras.BindingKey then
                local key = extras.BindingKey
                if name == "Escape" then extras.BindingKey = nil
                elseif name == "End" or name == "Insert" or name == "RightShift" or name == "Unknown" then
                    notify("Эта клавиша зарезервирована.")
                    return true
                else
                    for _, other in ipairs(keys) do if Settings["Bind_" .. other] == name then Settings["Bind_" .. other] = "" end end
                    Settings["Bind_" .. key] = name == "Backspace" and "" or name
                    extras.BindingKey = nil
                end
                refresh()
                return true
            end
            if processed or UserInputService:GetFocusedTextBox() or introActive or extras.PaletteOpen or extras.TelegramOpen then return false end
            for _, key in ipairs(keys) do
                if Settings["Bind_" .. key] == name then extras.ToggleActions[key](); return true end
            end
            return false
        end
    end

    extras.BuildConfigs = function()
        local cacheKey = "__NEXUS_CONFIGS_V1"
        if type(environment[cacheKey]) ~= "table" then environment[cacheKey] = {} end
        local cache = environment[cacheKey]
        local disk = type(writefile) == "function" and type(readfile) == "function"
        local choices = {
            TargetPart = { Head = true, HumanoidRootPart = true },
            RageTargetPart = { Head = true, HumanoidRootPart = true },
            RagePriority = { Crosshair = true, Distance = true, Health = true },
            ChamsMaterial = { Neon = true, Glass = true, SmoothPlastic = true },
            WeatherMode = { Rain = true, Snow = true, Storm = true, Blizzard = true },
            AtmospherePreset = { Sunset = true, Night = true, Morning = true, Horror = true },
            ParticleMode = { Fireflies = true, Sparks = true, Snow = true, Orbit = true },
            MenuTheme = { Graphite = true, Amethyst = true, Midnight = true, Rose = true, Custom = true },
            SkyPreset = { Default = true, Sunset = true, Legacy = true },
        }
        local profile = section(configs.left, "PROFILE")
        local storage = section(configs.right, "STORAGE")
        local nameRow = row(profile, "Имя конфига", "Латиница, цифры, _ и - · до 32 символов", 100)
        local nameInput = create("TextBox", { Name = "ConfigName", Position = UDim2.fromOffset(12, 59),
            Size = UDim2.new(1, -24, 0, 29), BackgroundColor3 = Theme.Background, BorderSizePixel = 0,
            Text = "default", PlaceholderText = "default", ClearTextOnFocus = false,
            Font = Enum.Font.Code, TextSize = 13, TextColor3 = Theme.Text }, nameRow)
        corner(nameInput, 4)
        row(storage, disk and "Файлы исполнителя" or "Память сессии",
            disk and "Nexus_<имя>.json · рабочая папка" or "Нет readfile/writefile · до закрытия игры", 66)
        local resultRow = row(storage, "Состояние", nil, 118)
        local status = text(resultRow, "Готово к сохранению и загрузке.", UDim2.fromOffset(12, 37),
            UDim2.new(1, -24, 0, 70), 11, Theme.Muted)
        status.Name, status.TextWrapped, status.TextTruncate = "ConfigStatus", true, Enum.TextTruncate.None
        local names, nextButton = {}, nil
        local function validName(name)
            return type(name) == "string" and #name >= 1 and #name <= 32 and name:match("^[%w_-]+$") ~= nil
        end
        local function selectedName()
            local name = nameInput.Text:match("^%s*(.-)%s*$")
            assert(validName(name), "Имя: 1–32 символа A–Z, 0–9, _ или -.")
            nameInput.Text = name
            return name
        end
        local function path(name) return "Nexus_" .. name .. ".json" end
        local function refreshNames()
            local found = {}
            for name, content in pairs(cache) do
                if validName(name) and type(content) == "string" then
                    local exists = true
                    if disk and type(isfile) == "function" then
                        local ok, value = pcall(isfile, path(name)); exists = ok and value
                    end
                    if exists then found[name] = true end
                end
            end
            if disk and type(listfiles) == "function" then
                local ok, files = pcall(listfiles, ".")
                if ok and type(files) == "table" then
                    for _, file in ipairs(files) do
                        if type(file) == "string" then
                            local base = file:gsub("\\", "/"):match("([^/]+)$")
                            local name = base and base:match("^Nexus_(.-)%.json$")
                            if validName(name) then found[name] = true end
                        end
                    end
                end
            end
            table.clear(names)
            for name in pairs(found) do table.insert(names, name) end
            table.sort(names)
            if nextButton then nextButton.Text = tostring(#names) .. " profiles" end
        end
        local function snapshot()
            local values = {}
            for key, value in pairs(Settings) do values[key] = typeof(value) == "Color3" and toHex(value) or value end
            return { app = "NEXUS", version = 1, settings = values }
        end
        local function decode(content)
            assert(type(content) == "string" and #content <= 262144, "Файл пуст, повреждён или превышает 256 KB.")
            local data = HttpService:JSONDecode(content)
            assert(type(data) == "table" and data.app == "NEXUS" and data.version == 1 and type(data.settings) == "table",
                "Неизвестный формат конфига NEXUS.")
            local values = {}
            for key, default in pairs(extras.Defaults) do
                local value = data.settings[key]
                if value == nil then value = default
                elseif typeof(default) == "Color3" then
                    assert(type(value) == "string", "Неверный цвет: " .. key)
                    value = parseHex(value)
                    assert(value, "Неверный HEX: " .. key)
                elseif type(default) == "boolean" then
                    assert(type(value) == "boolean", "Ожидался переключатель: " .. key)
                elseif type(default) == "number" then
                    local range = extras.Ranges[key]
                    assert(type(value) == "number" and value == value and math.abs(value) < math.huge and range,
                        "Неверное число: " .. key)
                    assert(value >= range[1] and value <= range[2], "Значение вне диапазона: " .. key)
                    value = math.clamp(range[1] + math.floor((value - range[1]) / range[3] + 0.5) * range[3], range[1], range[2])
                elseif type(default) == "string" then
                    if key:match("^Bind_") then
                        local ok, code = pcall(function() return Enum.KeyCode[value] end)
                        assert(type(value) == "string" and (value == "" or (ok and code and value ~= "Unknown" and value ~= "End" and value ~= "Insert" and value ~= "RightShift" and value ~= "Escape" and value ~= "Backspace")), "Неверная клавиша: " .. key)
                    elseif key:match("^Sky[BDFLRU][knftp]*$") then
                        assert(type(value) == "string" and (value == "" or (#value <= 20 and value:match("^%d+$"))), "Неверный ID неба: " .. key)
                    else
                        assert(type(value) == "string" and choices[key] and choices[key][value], "Неверный режим: " .. key)
                    end
                end
                values[key] = value
            end
            if data.settings.SkyPreset == nil then
                for _, key in ipairs({ "SkyBk", "SkyDn", "SkyFt", "SkyLf", "SkyRt", "SkyUp" }) do
                    if values[key] ~= "" then values.SkyPreset = "Legacy"; break end
                end
            end
            -- При конфликте режимов в стороннем JSON приоритет получает Fly.
            if values.Fly then values.Freecam = false end
            if values.AtmosphereEnabled then values.WorldEnabled = false end
            if not clickMouse then values.AutoShot, values.Trigger = false, false end
            return values
        end
        local function apply(values)
            stopEnvironment(); stopMotion(); stopFreecam(); stopWeather()
            restoreMovement(); restoreWorld(); restoreHitboxes(); restoreChams()
            for key in pairs(extras.Defaults) do Settings[key] = values[key] end
            extras.ResetFire()
            if extras.ApplyMenuStyle then extras.ApplyMenuStyle() end
            for _, refresh in pairs(toggleRefreshers) do refresh(false) end
            for _, refresh in pairs(extras.Refresh) do refresh() end
            targetButton.Text = Settings.TargetPart == "Head" and "Head" or "RootPart"
            materialButton.Text = Settings.ChamsMaterial
            weatherModeButton.Text = ({ Rain = "Дождь", Snow = "Снег", Storm = "Гроза", Blizzard = "Метель" })[Settings.WeatherMode]
            refreshAutoShotLock()
            fitWindow()
            applyMovement()
            if Settings.WorldEnabled then applyWorld() end
            if Settings.Freecam then
                local ok = protected("config-freecam", setFreecam, true)
                if not ok then Settings.Freecam = false; stopFreecam(); toggleRefreshers.Freecam(false) end
            end
        end
        local function operate(label, callback)
            local ok, message = pcall(callback)
            status.Text = ok and (message or label .. ": готово.") or (label .. ": " .. tostring(message))
            notify(status.Text)
        end
        local function applyWithRollback(values)
            local previousValues = {}
            for key, value in pairs(Settings) do previousValues[key] = value end
            local ok, problem = pcall(apply, values)
            if not ok then
                local restored, restoreProblem = pcall(apply, previousValues)
                if not restored then
                    stopMotion()
                    Settings.Fly, Settings.Noclip = false, false
                    toggleRefreshers.Fly(false); toggleRefreshers.Noclip(false)
                    error("Ошибка применения: " .. tostring(problem) .. "; ошибка восстановления: " .. tostring(restoreProblem))
                end
                error("Настройки не применены; прежние восстановлены: " .. tostring(problem))
            end
        end
        action(profile, "Сохранить конфиг", "Текущие настройки, цвета и режимы", "Save", function()
            operate("Сохранение", function()
                local name = selectedName()
                local content = HttpService:JSONEncode(snapshot())
                assert(#content <= 262144, "Конфиг слишком большой.")
                if disk then
                    writefile(path(name), content)
                    assert(readfile(path(name)) == content, "Запись файла не подтверждена.")
                end
                cache[name] = content
                refreshNames()
                return "Сохранён: " .. name .. (disk and " · JSON-файл." or " · только эта сессия.")
            end)
        end)
        action(profile, "Загрузить конфиг", "Применить сохранённые настройки", "Load", function()
            operate("Загрузка", function()
                local name = selectedName()
                local content
                if disk then content = readfile(path(name)) else content = cache[name] end
                assert(content, "Конфиг не найден: " .. name)
                local values = decode(content)
                applyWithRollback(values)
                cache[name] = content
                refreshNames()
                return "Загружен: " .. name .. "."
            end)
        end)
        nextButton = action(profile, "Выбрать сохранённый", "По очереди · можно ввести имя вручную", "0 profiles", function()
            operate("Выбор", function()
                refreshNames()
                assert(#names > 0, "Сохранённых профилей пока нет.")
                local index = 0
                for i, name in ipairs(names) do if name == nameInput.Text then index = i; break end end
                nameInput.Text = names[index % #names + 1]
                return "Выбран: " .. nameInput.Text .. ". Нажми Load."
            end)
        end)
        action(storage, "Обновить список", "Найти сохранённые профили", "Refresh", function()
            operate("Список", function() refreshNames(); return "Найдено профилей: " .. tostring(#names) .. "." end)
        end)
        action(storage, "Удалить конфиг", "Удалить профиль с указанным именем", "Delete", function()
            local ok, name = pcall(selectedName)
            if not ok then notify(tostring(name)); return end
            confirm("delete-config-" .. name, "Удалить «" .. name .. "»?", function()
                operate("Удаление", function()
                    if disk then
                        assert(type(delfile) == "function", "Исполнитель не поддерживает delfile.")
                        delfile(path(name))
                        if type(isfile) == "function" then assert(not isfile(path(name)), "Файл не удалён.") end
                    else assert(cache[name], "Конфиг не найден.") end
                    cache[name] = nil
                    refreshNames()
                    return "Удалён: " .. name .. "."
                end)
            end)
        end, true)
        action(storage, "Сбросить настройки", "Вернуть значения по умолчанию", "Reset", function()
            operate("Сброс", function() applyWithRollback(extras.Defaults); return "Настройки сброшены. Файлы конфигов сохранены." end)
        end)
        refreshNames()
    end
    extras.BuildConfigs()
    extras.BuildConfigs = nil

    extras.BuildMenuStyle = function()
        local presetKeys = { "MenuBackground", "MenuPanel", "MenuAccent", "MenuText", "MenuMuted" }
        local presets = {
            Graphite = { "101113", "191B1F", "C6CAD2", "ECEDEF", "969BA6" },
            Amethyst = { "0A0C10", "0F1218", "A69EC2", "E5E6EB", "858D9A" },
            Midnight = { "080F1C", "101E32", "83B5E5", "E5EFFA", "8B9FB8" },
            Rose = { "170F14", "241820", "D59BAF", "F5E9EE", "AB909E" },
        }
        local labels = { Graphite = "Graphite", Amethyst = "Amethyst", Midnight = "Midnight", Rose = "Rose", Custom = "Своя тема" }
        local ui = section(configs.right, "MENU STYLE")
        local choice
        local function refreshLabel() choice.Text = labels[Settings.MenuTheme] or "Своя тема" end
        local function refreshColors()
            for _, key in ipairs(presetKeys) do if extras.Refresh[key] then extras.Refresh[key](extras.ActivePaletteKey() == key) end end
        end
        extras.ApplyMenuStyle = function()
            Theme.Background, Theme.Card = Settings.MenuBackground, Settings.MenuPanel
            Theme.Sidebar = Theme.Background:Lerp(Theme.Card, 0.55)
            Theme.Text, Theme.Muted = Settings.MenuText, Settings.MenuMuted
            Theme.Accent, Theme.Green = Settings.MenuAccent, Settings.MenuAccent
            Theme.Hover = Theme.Card:Lerp(Theme.Accent, 0.12)
            Theme.Line = Theme.Card:Lerp(Theme.Muted, 0.22)
            Theme.DarkAccent = Theme.Card:Lerp(Theme.Accent, 0.18)
            local opacity = Settings.MenuTransparency / 100
            for object, binding in pairs(extras.ThemeBindings) do
                if object == panel or object:IsDescendantOf(panel) then
                    if object:IsA("TextButton") and activeTweens[object] then activeTweens[object]:Cancel() end
                    for property, token in pairs(binding.colors) do object[property] = Theme[token] end
                    if binding.colors.BackgroundColor3 and not binding.noTransparency then
                        if binding.baseTransparency == nil then binding.baseTransparency = object.BackgroundTransparency or 0 end
                        object.BackgroundTransparency = binding.baseTransparency + (1 - binding.baseTransparency) * opacity
                    end
                end
            end
            for name, tab in pairs(tabButtons) do
                local selected = name == selectedPage
                tab.BackgroundColor3 = selected and Theme.Hover or Theme.Sidebar
                tab.TextColor3 = selected and Theme.Text or Theme.Muted
                tab:FindFirstChild("TabTitle").TextColor3 = tab.TextColor3
                tabIconColors[name](selected and Theme.Accent or Theme.Muted)
            end
            for _, refresh in pairs(toggleRefreshers) do refresh(false) end
            refreshColors()
            refreshLabel()
        end
        local function applyPreset(name)
            Settings.MenuTheme = name
            for i, key in ipairs(presetKeys) do Settings[key] = parseHex(presets[name][i]) end
            extras.ApplyMenuStyle()
        end
        choice = action(ui, "Тема меню", "Нажми для смены готовой темы", labels[Settings.MenuTheme], function()
            local names, index = { "Graphite", "Amethyst", "Midnight", "Rose" }, 0
            for i, name in ipairs(names) do if name == Settings.MenuTheme then index = i; break end end
            applyPreset(names[index % #names + 1])
        end)
        choice.Name = "MenuThemeChoice"
        extras.Refresh.MenuTheme = refreshLabel
        local function custom()
            Settings.MenuTheme = "Custom"
            extras.ApplyMenuStyle()
        end
        colorPicker(ui, "Основной цвет", "MenuAccent", custom)
        colorPicker(ui, "Фон окна", "MenuBackground", custom)
        colorPicker(ui, "Фон блоков", "MenuPanel", custom)
        colorPicker(ui, "Основной текст", "MenuText", custom)
        colorPicker(ui, "Вторичный текст", "MenuMuted", custom)
        slider(ui, "Прозрачность фона", "MenuTransparency", 0, 70, 5, "%", extras.ApplyMenuStyle)
        action(ui, "Сброс оформления", "Цвета Amethyst и непрозрачный фон", "Reset style", function()
            Settings.MenuTransparency = 0
            extras.Refresh.MenuTransparency()
            applyPreset("Amethyst")
        end)
        extras.ApplyMenuStyle()
    end
    extras.BuildMenuStyle()
    extras.BuildMenuStyle = nil

    -- Быстрое отключение не удаляет меню, значения ползунков или файлы профилей.
    extras.DisableAll = function()
        for _, key in ipairs({ "Aim", "AutoAim", "AutoShot", "Trigger", "ESP", "Chams", "Hitbox",
            "Freecam", "Noclip", "Fly", "SpeedEnabled", "JumpEnabled", "Bhop", "WorldEnabled", "Weather",
            "Crosshair", "Watermark", "TargetCard", "AtmosphereEnabled", "CustomSky", "AmbientParticles", "CharacterParticles" }) do
            Settings[key] = false
            if toggleRefreshers[key] then toggleRefreshers[key](false) end
        end
        rightMouseHeld, activeSlider, dragWindow = false, nil, nil
        extras.ResetFire()
        extras.ClosePalette()
        extras.CloseTelegram()
        refreshAutoShotLock()
        local restored = true
        for _, restore in ipairs({ stopEnvironment, stopMotion, stopFreecam, restoreMovement, restoreWorld, restoreHitboxes,
            restoreChams, stopWeather, extras.HideTargetCard, extras.HideWatermark }) do
            if not protected("disable-all-restore", restore) then restored = false end
        end
        fovCircle.Visible, crosshair.Visible = false, false
        for _, record in pairs(records) do
            if not protected("disable-all-overlay", hideRecord, record) then restored = false end
        end
        notify(restored and "Активные функции отключены. Мир и персонаж восстановлены."
            or "Функции отключены. При восстановлении возникла ошибка — проверь консоль.")
    end

    RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
        if alive then protected("camera", cameraFrame, deltaTime) end
    end)
    renderBound = true
    RunService:BindToRenderStep(renderName .. "_ESP", Enum.RenderPriority.Last.Value + 1, function(deltaTime)
        if alive then protected("render", frame, deltaTime) end
    end)
    environment[sessionKey] = controller
    extras.StartIntro()
end)

if not bootOK then
    if emergencyCleanup then pcall(emergencyCleanup) end
    warn("[Nexus] Не удалось запустить панель: " .. tostring(bootError))
end
