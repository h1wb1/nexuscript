    -- Inline settings drawers preserve existing controls, callbacks and config bindings.
    do
        local drawers, drawerState = {}, {}
        local function setDrawer(drawer, open)
            local state = drawerState[drawer]
            state.serial = state.serial + 1
            state.open = open
            local serial = state.serial
            if open then drawer.Visible = true end
            tween(drawer, { Size = UDim2.new(1, 0, 0, open and state.height or 0) }, 0.2)
            if not open then task.delay(0.2, function()
                if alive and state.serial == serial then drawer.Visible = false end
            end) end
        end
