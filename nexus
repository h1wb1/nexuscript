    local function makeLine(parent, color, thickness)
        return create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color,
            Size = UDim2.fromOffset(1, thickness or 1), BorderSizePixel = 0, Visible = false }, parent)
    end
    local function drawLine(line, from, to, thickness)
        local delta = to - from
        local length = delta.Magnitude
        line.Visible = length > 0.5
        if length <= 0.5 then return end
        line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
        line.Size = UDim2.fromOffset(length, thickness or 1)
        line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    end
