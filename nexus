    local function toggle(parent, title, description, key, callback)
        local frame = row(parent, title, description)
        extras.ToggleRows[key] = frame
        local track = button(frame, "", UDim2.new(1, -45, 0, 12), UDim2.fromOffset(32, 18), Theme.Line)
        corner(track, 9)
        local knob = create("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2),
            BackgroundColor3 = Theme.Text, BorderSizePixel = 0 }, track)
        corner(knob, 7)
        local function refresh(animate)
            local targetPosition = UDim2.fromOffset(Settings[key] and 16 or 2, 2)
            local targetColor = Settings[key] and Theme.Green or Theme.Line
            if animate then
                tween(track, { BackgroundColor3 = targetColor })
                tween(knob, { Position = targetPosition })
            else
                track.BackgroundColor3, knob.Position = targetColor, targetPosition
            end
        end
        toggleRefreshers[key] = refresh
        refresh(false)
        extras.ToggleActions[key] = function()
            if featureLocks[key] then return end
            Settings[key] = not Settings[key]
            refresh(true)
            if callback then callback(Settings[key]) end
        end
        connect(track.Activated, "toggle-" .. key, extras.ToggleActions[key])
    end

    -- Один общий обработчик движения вместо новых подключений на каждое нажатие.
    local activeSlider, dragWindow
    local function slider(parent, title, key, minimum, maximum, step, unit, callback, formatValue)
        extras.Ranges[key] = { minimum, maximum, step }
        local frame = row(parent, title, nil, 72, 120)
        local valueLabel = text(frame, "", UDim2.new(1, -106, 0, 10), UDim2.fromOffset(92, 20), 12, Theme.Accent)
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        local hit = button(frame, "", UDim2.new(0, 14, 0, 39), UDim2.new(1, -28, 0, 24))
        hit.BackgroundTransparency = 1
        local track = create("Frame", { Position = UDim2.new(0, 0, 0.5, -2), Size = UDim2.new(1, 0, 0, 4),
            BackgroundColor3 = Theme.Line, BorderSizePixel = 0 }, hit)
        corner(track, 2)
        local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0 }, track)
        corner(fill, 2)
        local handle = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Theme.Text, BorderSizePixel = 0 }, track)
        corner(handle, 6)
        local function refresh()
            local fraction = (Settings[key] - minimum) / (maximum - minimum)
            fill.Size = UDim2.fromScale(fraction, 1)
            handle.Position = UDim2.fromScale(fraction, 0.5)
            valueLabel.Text = formatValue and formatValue(Settings[key]) or (tostring(Settings[key]) .. (unit or ""))
        end
        local function update(x)
            if featureLocks[key] then return end
            local fraction = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
            local value = math.clamp(minimum + math.floor(fraction * (maximum - minimum) / step + 0.5) * step, minimum, maximum)
            if value ~= Settings[key] then
                Settings[key] = value
                refresh()
                if callback then callback(value) end
            end
        end
        refresh()
        extras.Refresh[key] = refresh
        connect(hit.InputBegan, "slider-" .. key, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeSlider = { input = input, update = update }
                update(input.Position.X)
            end
        end)
    end
