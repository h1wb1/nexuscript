    -- Lighting и Atmosphere восстанавливаются отдельно от UI/персонажа.
    -- Без WorldKeep значения задаются только по действию пользователя.
    local worldOriginals = {}
    local function worldWrite(object, property, value)
        local saved = worldOriginals[object]
        if not saved then saved = { original = {}, last = {} }; worldOriginals[object] = saved end
        if saved.original[property] == nil then saved.original[property] = object[property] end
        saved.last[property] = value
        if object[property] ~= value then object[property] = value end
    end
    local function restoreWorldObject(object)
        local saved = worldOriginals[object]
        if not saved then return end
        if object == Lighting or object.Parent then
            for property, value in pairs(saved.original) do
                protected("world-restore-" .. property, function()
                    if object[property] == saved.last[property] then object[property] = value end
                end)
            end
        end
        worldOriginals[object] = nil
    end
    restoreWorld = function()
        for object in pairs(worldOriginals) do protected("world-restore", restoreWorldObject, object) end
    end
    local function applyWorld()
        if Settings.WorldEnabled and Settings.AtmosphereEnabled then
            Settings.AtmosphereEnabled = false
            if extras.StopAtmosphere then extras.StopAtmosphere() end
            if toggleRefreshers.AtmosphereEnabled then toggleRefreshers.AtmosphereEnabled(true) end
        elseif Settings.AtmosphereEnabled then return end
        if not Settings.WorldEnabled then restoreWorld(); return end
        local minutes = math.clamp(Settings.WorldTime, 0, 1439)
        local time = string.format("%02d:%02d:00", math.floor(minutes / 60), minutes % 60)
        worldWrite(Lighting, "TimeOfDay", time)
        worldWrite(Lighting, "Brightness", Settings.WorldBrightness / 10)
        worldWrite(Lighting, "Ambient", Settings.WorldAmbient)
        worldWrite(Lighting, "OutdoorAmbient", Settings.WorldOutdoorAmbient)
        worldWrite(Lighting, "GlobalShadows", Settings.WorldShadows)
        worldWrite(Lighting, "FogStart", 0)
        worldWrite(Lighting, "FogEnd", Settings.WorldFogEnd)
        worldWrite(Lighting, "FogColor", Settings.WorldFogColor)
        if Settings.WorldClearAtmosphere then
            for _, object in ipairs(Lighting:GetChildren()) do
                if object:IsA("Atmosphere") then
                    protected("atmosphere-clear", function()
                        worldWrite(object, "Density", 0)
                        worldWrite(object, "Haze", 0)
                    end)
                end
            end
        else
            for object in pairs(worldOriginals) do if object ~= Lighting then restoreWorldObject(object) end end
        end
    end
    connect(Lighting.ChildAdded, "world-atmosphere-added", function(child)
        if Settings.WorldEnabled and Settings.WorldClearAtmosphere and child:IsA("Atmosphere") then applyWorld() end
    end)

