    -- Локальная погода: ограниченный пул независимых деталей, без текстур/HTTP.
    -- Эффекты не меняют физику карты и исключены из лучей прицеливания.
    do
        local folder, grading, currentMode
        local particles, bolts = {}, {}
        local roofTimer, sheltered, flash, nextFlash = 0, false, 0, 8
        local roofParams = RaycastParams.new()
        roofParams.FilterType = Enum.RaycastFilterType.Exclude
        roofParams.IgnoreWater = true
        local function randomRange(low, high) return low + math.random() * (high - low) end
        local function particlePart(name, size, color, material)
            return create("Part", {
                Name = name, Size = size, Color = color, Material = material,
                Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
                CastShadow = false, Transparency = 1,
            }, folder)
        end
        local function respawn(particle, center, spread)
            particle.position = center + Vector3.new(randomRange(-28, 28), randomRange(spread and -12 or 14, 26), randomRange(-28, 28))
            particle.phase = randomRange(0, math.pi * 2)
        end
        stopWeather = function()
            if folder then folder:Destroy(); folder = nil end
            if grading then grading:Destroy(); grading = nil end
            table.clear(particles)
            table.clear(bolts)
            currentMode, roofTimer, sheltered, flash, nextFlash = nil, 0, false, 0, randomRange(7, 12)
        end
        extras.WeatherFrame = function(camera, dt)
            if not Settings.Weather or introActive then
                if folder or grading then stopWeather() end
                return
            end
            local mode = Settings.WeatherMode
            local snowy, storm = mode == "Snow" or mode == "Blizzard", mode == "Storm"
            local center = camera.CFrame.Position
            dt = math.clamp(dt, 0, 0.1)
            if not folder or currentMode ~= mode then
                stopWeather()
                folder = create("Folder", { Name = "NexusWeather" }, worldFolder)
                currentMode = mode
                grading = create("ColorCorrectionEffect", {
                    Name = "NexusWeatherGrade", Enabled = true, Brightness = 0,
                    Contrast = 0, Saturation = 0, TintColor = Color3.fromRGB(255, 255, 255),
                }, Lighting)
            end
            -- Пул ограничен 180 объектами осадков, без создания объектов каждый кадр.
            local count = math.clamp(math.floor(40 + Settings.WeatherIntensity * 1.4), 40, 180)
            while #particles > count do particles[#particles].part:Destroy(); table.remove(particles) end
            while #particles < count do
                local size = snowy and randomRange(0.09, 0.19) or randomRange(1.1, 2.1)
                local part = particlePart(snowy and "Snowflake" or "Raindrop",
                    snowy and Vector3.new(size, size, size) or Vector3.new(0.035, size, 0.035),
                    snowy and Color3.fromRGB(233, 236, 242) or Color3.fromRGB(173, 185, 201), Enum.Material.SmoothPlastic)
                if snowy then part.Shape = Enum.PartType.Ball end
                local particle = { part = part, speed = snowy and randomRange(5, 10) or randomRange(48, 68) }
                respawn(particle, center, true)
                table.insert(particles, particle)
            end
            roofTimer = roofTimer - dt
            if not Settings.WeatherRoofCheck then
                sheltered = false
            elseif roofTimer <= 0 then
                roofTimer = 0.3
                local ignored = { worldFolder, camera }
                if localPlayer.Character then table.insert(ignored, localPlayer.Character) end
                roofParams.FilterDescendantsInstances = ignored
                sheltered = workspace:Raycast(center, Vector3.new(0, 90, 0), roofParams) ~= nil
            end
            local wind = Settings.WeatherWind + (mode == "Blizzard" and 16 or 0)
            for _, particle in ipairs(particles) do
                particle.phase = particle.phase + dt * 1.7
                local drift = snowy and math.sin(particle.phase) * 1.8 or 0
                particle.position = particle.position + Vector3.new(wind + drift, -particle.speed, drift * 0.5) * dt
                local relative = particle.position - center
                if relative.Y < -18 or relative.Y > 34 or math.abs(relative.X) > 36 or math.abs(relative.Z) > 36 then
                    respawn(particle, center, false)
                end
                particle.part.CFrame = CFrame.new(particle.position)
                particle.part.Transparency = sheltered and 1 or snowy and 0.12 or 0.35
            end
            -- Редкие короткие вспышки и отдельный зигзаг молнии; исходный Lighting не меняется.
            flash = math.max(0, flash - dt)
            nextFlash = nextFlash - dt
            if storm and Settings.WeatherLightning and not sheltered and nextFlash <= 0 then
                nextFlash, flash = randomRange(7, 13), 0.24
                local forward = camera.CFrame.LookVector
                local base = center + Vector3.new(forward.X * 55, 0, forward.Z * 55)
                local previousPoint = base + Vector3.new(randomRange(-14, 14), 42, 0)
                for i = 1, 4 do
                    local point = base + Vector3.new(randomRange(-8, 8), 42 - i * 10, randomRange(-3, 3))
                    local bolt = bolts[i]
                    if not bolt then
                        bolt = particlePart("Lightning", Vector3.new(0.15, 0.15, 1), Color3.fromRGB(221, 225, 240), Enum.Material.Neon)
                        bolts[i] = bolt
                    end
                    bolt.Size = Vector3.new(0.15, 0.15, (point - previousPoint).Magnitude)
                    bolt.CFrame = CFrame.lookAt((previousPoint + point) / 2, point)
                    previousPoint = point
                end
            end
            local flashing = storm and Settings.WeatherLightning and flash > 0 and not sheltered
            for _, bolt in ipairs(bolts) do bolt.Transparency = flashing and 0.05 or 1 end
            grading.Brightness = (storm and -0.045 or mode == "Blizzard" and -0.02 or 0) + (flashing and 0.18 * flash / 0.24 or 0)
            grading.Saturation = storm and -0.22 or mode == "Blizzard" and -0.12 or 0
        end
    end

    -- Данные игрока читаются заново: после смерти старые ссылки не используются.
    local function enemyData(player, teamCheck)
        if player == localPlayer or player.Parent ~= Players then return nil end
        if teamCheck == nil then teamCheck = Settings.TeamCheck end
        if teamCheck and localPlayer.Team ~= nil and not localPlayer.Neutral and not player.Neutral and localPlayer.Team == player.Team then return nil end
        local character = player.Character
        if not character or not character.Parent then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then return nil end
        return character, humanoid, rootPart
    end

    -- Proxy имеет отдельную assembly: ни одного Weld/Motor6D/Constraint.
    -- Anchored устанавливается только НОВОМУ proxy, никогда исходному телу.
    -- Некоторые клиентские raycast-оружия распознают его по родителю Character;
    -- для серверной регистрации попаданий универсального контракта нет.
    local hitboxProxies, proxyEpoch = {}, 0
    local function removeProxy(player)
        local entry = hitboxProxies[player]
        if entry then
            hitboxProxies[player] = nil
            entry.part:Destroy()
        end
    end
    restoreHitboxes = function()
        for player in pairs(hitboxProxies) do protected("proxy-remove", removeProxy, player) end
    end
    updateHitboxes = function()
        if not Settings.Hitbox then restoreHitboxes(); return end
        proxyEpoch = proxyEpoch + 1
        for _, player in ipairs(Players:GetPlayers()) do
            protected("proxy-player", function()
                local character, _, rootPart = enemyData(player)
                if not character then return end
                local entry = hitboxProxies[player]
                if entry and (entry.character ~= character or not entry.part.Parent) then removeProxy(player); entry = nil end
                if not entry then
                    local proxy = Instance.new("Part")
                    entry = { part = proxy, character = character }
                    hitboxProxies[player] = entry
                    proxy.Name = "NexusHitProxy"
                    proxy.Anchored, proxy.CanCollide, proxy.CanTouch = true, false, false
                    proxy.CanQuery, proxy.CastShadow = true, false
                    proxy.Transparency = 1
                    proxy.Material = Enum.Material.ForceField
                    proxy.CFrame = rootPart.CFrame
                    proxy.Parent = character
                end
                entry.epoch = proxyEpoch
                local size = Settings.HitboxSize
                entry.part.Size = Vector3.new(size, size, size)
                entry.part.CFrame = rootPart.CFrame
                entry.part.Color = Settings.BoxColor
                entry.part.Transparency = Settings.HitboxVisible and 0.85 or 1
            end)
        end
        for player, entry in pairs(hitboxProxies) do
            if entry.epoch ~= proxyEpoch then protected("proxy-retire", removeProxy, player) end
        end
    end
    local function isProxy(part)
        for _, entry in pairs(hitboxProxies) do if part == entry.part then return true end end
        return false
    end
    local function rayIgnore(character, camera, excludeProxies)
        local ignored = { character, camera, worldFolder }
        if excludeProxies then
            for _, entry in pairs(hitboxProxies) do table.insert(ignored, entry.part) end
        end
        return ignored
    end

    -- Chams меняют только визуальное представление. Копии не участвуют
    -- ни в столкновениях, ни в raycast, не содержат скриптов или соединений.
    local chamsRecords, chamsEpoch = {}, 0
    local function restoreChamsPart(original, entry)
        if original.Parent and original.LocalTransparencyModifier == 1 then
            original.LocalTransparencyModifier = entry.transparency
        end
        entry.copy:Destroy()
    end
    local function removeChams(player)
        local record = chamsRecords[player]
        if not record then return end
        chamsRecords[player] = nil
        for original, entry in pairs(record.parts) do protected("chams-part-restore", restoreChamsPart, original, entry) end
        record.model:Destroy()
    end
    restoreChams = function()
        for player in pairs(chamsRecords) do protected("chams-remove", removeChams, player) end
    end
    local function addChamsPart(record, original)
        local copy = original:Clone()
        if not copy then return end -- Archivable=false: оставляем оригинал видимым.
        record.parts[original] = { copy = copy, transparency = original.LocalTransparencyModifier }
        -- Сохраняем только геометрию SpecialMesh; Script/LocalScript, joints,
        -- SurfaceAppearance и текстуры не должны попасть в живую копию.
        local mesh = copy:FindFirstChildOfClass("SpecialMesh")
        if mesh then mesh.Parent = nil; mesh:ClearAllChildren(); mesh.TextureId = "" end
        copy:ClearAllChildren()
        if mesh then mesh.Parent = copy end
        if copy:IsA("MeshPart") then copy.TextureID = "" end
        copy.Anchored, copy.CanCollide, copy.CanTouch, copy.CanQuery = true, false, false, false
        copy.CastShadow = false
        copy.MaterialVariant = ""
        copy.CFrame = original.CFrame
        copy.Transparency = 1 - Settings.ChamsOpacity / 100
        copy.Color, copy.Material = Settings.ChamsColor, Enum.Material[Settings.ChamsMaterial]
        copy.LocalTransparencyModifier = 0
        copy.Parent = record.model
        original.LocalTransparencyModifier = 1
    end
    updateChams = function()
        if not Settings.Chams then restoreChams(); return end
        chamsEpoch = chamsEpoch + 1
        local now, camera = os.clock(), workspace.CurrentCamera
        for _, player in ipairs(Players:GetPlayers()) do
            local ok = protected("chams-player", function()
                local character, _, rootPart = enemyData(player, not Settings.ESPTeammates)
                if not character or not camera or (camera.CFrame.Position - rootPart.Position).Magnitude > Settings.MaxDistance then return end
                local record = chamsRecords[player]
                if record and record.character ~= character then removeChams(player); record = nil end
                if not record then
                    local model = create("Model", { Name = "NexusChams_" .. tostring(player.UserId) }, worldFolder)
                    record = { model = model, character = character, parts = {}, nextScan = 0 }
                    chamsRecords[player] = record
                    record.highlight = create("Highlight", { Adornee = model, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, model)
                end
                record.epoch = chamsEpoch
                if now >= record.nextScan then
                    record.nextScan = now + 0.5
                    for _, original in ipairs(character:GetChildren()) do
                        if original:IsA("BasePart") and original.Name ~= "HumanoidRootPart" and not isProxy(original) and not record.parts[original] then
                            addChamsPart(record, original)
                        end
                    end
                end
                for original, entry in pairs(record.parts) do
                    if original.Parent ~= character then
                        protected("chams-stale-part", restoreChamsPart, original, entry)
                        record.parts[original] = nil
                    else
                        entry.copy.CFrame, entry.copy.Size = original.CFrame, original.Size
                        entry.copy.Color, entry.copy.Material = Settings.ChamsColor, Enum.Material[Settings.ChamsMaterial]
                        entry.copy.Transparency = 1 - Settings.ChamsOpacity / 100
                    end
                end
                record.highlight.Enabled = true
                record.highlight.FillColor, record.highlight.OutlineColor = Settings.ChamsColor, Settings.ChamsColor
                record.highlight.FillTransparency = math.clamp(1 - Settings.ChamsOpacity / 100 + 0.1, 0, 1)
                record.highlight.OutlineTransparency = Settings.ChamsOutline and 0.1 or 1
            end)
            if not ok then protected("chams-failure-cleanup", removeChams, player) end
        end
        for player, record in pairs(chamsRecords) do
            if record.epoch ~= chamsEpoch then protected("chams-retire", removeChams, player) end
        end
    end
    connect(Players.PlayerRemoving, "effects-player-removing", function(player)
        protected("proxy-player-remove", removeProxy, player)
        protected("chams-player-remove", removeChams, player)
    end)

    -- Freecam не привязан к персонажу и не меняет его положение.
    -- ContextActionService временно забирает клавиши движения у стандартных контролов.
    local freecam, freecamAction = nil, renderName .. "_FreecamInput"
    local freecamKeys = {
        Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
        Enum.KeyCode.Space, Enum.KeyCode.LeftControl, Enum.KeyCode.LeftShift,
    }
    local function releaseCameraState()
        if not freecam then return end
        local saved = freecam
        freecam = nil
        protected("freecam-mouse-restore", function()
            if saved.locked and UserInputService.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition then
                UserInputService.MouseBehavior = saved.mouse
            end
        end)
        protected("freecam-camera-restore", function()
            local camera = saved.camera
            if camera and camera.Parent then
                camera.CFrame, camera.Focus = saved.frame, saved.focus
                local subject = saved.subject
                if not subject or not subject.Parent then
                    subject = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
                end
                if subject then camera.CameraSubject = subject end
                camera.CameraType = saved.kind
            end
        end)
    end
    stopFreecam = function()
        protected("freecam-unbind", function() ContextActionService:UnbindAction(freecamAction) end)
        releaseCameraState()
    end
    local function captureFreecam(camera)
        local pitch, yaw = camera.CFrame:ToOrientation()
        freecam = {
            camera = camera, frame = camera.CFrame, focus = camera.Focus,
            kind = camera.CameraType, subject = camera.CameraSubject,
            mouse = UserInputService.MouseBehavior, position = camera.CFrame.Position,
            pitch = pitch, yaw = yaw, velocity = Vector3.new(), locked = false,
        }
        camera.CameraType = Enum.CameraType.Scriptable
    end
    setFreecam = function(enabled)
        if not enabled then stopFreecam(); return end
        if freecam then return end
        local camera = workspace.CurrentCamera
        assert(camera, "Камера отсутствует")
        captureFreecam(camera)
        ContextActionService:BindActionAtPriority(freecamAction, function()
            local ok, result = protected("freecam-input", function()
                if not alive or not Settings.Freecam or UserInputService:GetFocusedTextBox() then
                    return Enum.ContextActionResult.Pass
                end
                return Enum.ContextActionResult.Sink
            end)
            return ok and result or Enum.ContextActionResult.Pass
        end, false, Enum.ContextActionPriority.High.Value + 100, table.unpack(freecamKeys))
    end
    local function freecamFrame(camera, dt)
        if not Settings.Freecam then return end
        if not freecam then setFreecam(true) end
        if freecam.camera ~= camera then
            releaseCameraState()
            captureFreecam(camera)
        end
        local state = freecam
        local canMove = windowFocused and not menuOpen and not UserInputService:GetFocusedTextBox() and not GuiService.MenuIsOpen
        local look = canMove and rightMouseHeld
        if look then
            if not state.locked then
                state.mouse = UserInputService.MouseBehavior
                state.locked = true
            end
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
            local delta = UserInputService:GetMouseDelta()
            state.yaw = state.yaw - delta.X * 0.0028
            state.pitch = math.clamp(state.pitch - delta.Y * 0.0028, math.rad(-89), math.rad(89))
        elseif state.locked then
            if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition then UserInputService.MouseBehavior = state.mouse end
            state.locked = false
        end
        local function down(key) return canMove and UserInputService:IsKeyDown(key) and 1 or 0 end
        local movement = Vector3.new(down(Enum.KeyCode.D) - down(Enum.KeyCode.A),
            down(Enum.KeyCode.Space) - down(Enum.KeyCode.LeftControl), down(Enum.KeyCode.S) - down(Enum.KeyCode.W))
        if movement.Magnitude > 1 then movement = movement.Unit end
        local rotation = CFrame.fromOrientation(state.pitch, state.yaw, 0)
        local speed = Settings.FreecamSpeed * (down(Enum.KeyCode.LeftShift) == 1 and 3 or 1)
        local desired = rotation:VectorToWorldSpace(movement) * speed
        local alpha = 1 - math.exp(-14 * math.min(dt, 0.1))
        state.velocity = canMove and state.velocity:Lerp(desired, alpha) or Vector3.new()
        state.position = state.position + state.velocity * math.min(dt, 0.1)
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.new(state.position) * rotation
        camera.Focus = camera.CFrame * CFrame.new(0, 0, -32)
    end

    -- Noclip меняет только CanCollide своего персонажа до шага физики.
    -- Fly использует современные constraints; Anchored и размер тела не меняются.
    do
        local collisionOriginals, collisionCharacter = {}, nil
        local flight
        extras.StopNoclip = function()
            for part, original in pairs(collisionOriginals) do
                protected("noclip-restore", function()
                    if part.Parent and part.CanCollide == false then part.CanCollide = original end
                end)
            end
            table.clear(collisionOriginals)
            collisionCharacter = nil
        end
        extras.StopFly = function()
            local saved = flight
            flight = nil
            if not saved then return end
            for _, object in ipairs(saved.objects) do pcall(function() object:Destroy() end) end
            protected("fly-humanoid-restore", function()
                local humanoid = saved.humanoid
                if humanoid.Parent then
                    if humanoid.AutoRotate == false then humanoid.AutoRotate = saved.autoRotate end
                    if humanoid.PlatformStand == true then
                        humanoid.PlatformStand = saved.platformStand
                        if not saved.platformStand and humanoid.Health > 0 then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
                    end
                end
            end)
            protected("fly-velocity-stop", function()
                if saved.root.Parent and not saved.root.Anchored then
                    saved.root.AssemblyLinearVelocity = Vector3.new()
                    saved.root.AssemblyAngularVelocity = Vector3.new()
                end
            end)
        end
        stopMotion = function()
            pcall(extras.StopFly)
            pcall(extras.StopNoclip)
        end
        local function noclipStep()
            local character = localPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not Settings.Noclip or not character or not character.Parent or not humanoid or humanoid.Health <= 0 then
                extras.StopNoclip()
                return
            end
            if collisionCharacter ~= character then extras.StopNoclip(); collisionCharacter = character end
            for part, original in pairs(collisionOriginals) do
                if not part:IsDescendantOf(character) then
                    if part.Parent and part.CanCollide == false then part.CanCollide = original end
                    collisionOriginals[part] = nil
                end
            end
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if collisionOriginals[part] == nil then collisionOriginals[part] = part.CanCollide end
                    part.CanCollide = false
                end
            end
        end
        local function flyStep(dt)
            local character, camera = localPlayer.Character, workspace.CurrentCamera
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local body = character and character:FindFirstChild("HumanoidRootPart")
            if not Settings.Fly or Settings.Freecam or introActive or not camera or not character or not character.Parent
                or not humanoid or humanoid.Health <= 0 or humanoid.Sit or not body or not body:IsA("BasePart") or body.Anchored then
                extras.StopFly()
                return
            end
            if flight and (flight.root ~= body or flight.humanoid ~= humanoid or not flight.velocity.Parent
                or not flight.orientation.Parent or not flight.attachment.Parent) then extras.StopFly() end
            if not flight then
                flight = { root = body, humanoid = humanoid, autoRotate = humanoid.AutoRotate,
                    platformStand = humanoid.PlatformStand, objects = {}, desired = Vector3.new() }
                -- Регистрируем каждый объект до установки свойств для очистки частичной сборки.
                local function add(className, properties)
                    local object = Instance.new(className)
                    table.insert(flight.objects, object)
                    for key, value in pairs(properties) do object[key] = value end
                    object.Parent = body
                    return object
                end
                flight.attachment = add("Attachment", { Name = "NexusFlyAttachment" })
                flight.velocity = add("LinearVelocity", { Name = "NexusFlyVelocity", Attachment0 = flight.attachment,
                    RelativeTo = Enum.ActuatorRelativeTo.World, VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
                    ForceLimitsEnabled = false, VectorVelocity = Vector3.new() })
                flight.orientation = add("AlignOrientation", { Name = "NexusFlyOrientation", Attachment0 = flight.attachment,
                    Mode = Enum.OrientationAlignmentMode.OneAttachment, MaxTorque = 10000000,
                    Responsiveness = 18, MaxAngularVelocity = 100, RigidityEnabled = false })
            end
            humanoid.PlatformStand, humanoid.AutoRotate = true, false
            local canMove = windowFocused and not menuOpen and not GuiService.MenuIsOpen and not UserInputService:GetFocusedTextBox()
            local function down(key) return canMove and UserInputService:IsKeyDown(key) and 1 or 0 end
            local localDirection = Vector3.new(down(Enum.KeyCode.D) - down(Enum.KeyCode.A), 0,
                down(Enum.KeyCode.S) - down(Enum.KeyCode.W))
            local direction = camera.CFrame:VectorToWorldSpace(localDirection)
                + Vector3.new(0, down(Enum.KeyCode.Space) - down(Enum.KeyCode.LeftControl), 0)
            if direction.Magnitude > 1 then direction = direction.Unit end
            local speed = Settings.FlySpeed * (down(Enum.KeyCode.LeftShift) == 1 and 2 or 1)
            flight.desired = canMove and flight.desired:Lerp(direction * speed, 1 - math.exp(-16 * math.clamp(dt, 0, 0.1))) or Vector3.new()
            flight.velocity.VectorVelocity = flight.desired
            local forward = camera.CFrame.LookVector
            local flat = Vector3.new(forward.X, 0, forward.Z)
            if flat.Magnitude > 0.001 then flight.orientation.CFrame = CFrame.lookAt(Vector3.new(), flat.Unit) end
        end
        connect(RunService.PreSimulation, "motion-physics", function(dt)
            if not protected("noclip", noclipStep) then
                Settings.Noclip = false
                extras.StopNoclip()
                toggleRefreshers.Noclip(true)
                notify("Noclip выключен после ошибки.")
            end
            if not protected("fly", flyStep, dt) then
                Settings.Fly = false
                extras.StopFly()
                toggleRefreshers.Fly(true)
                notify("Fly выключен после ошибки.")
            end
        end)
    end

