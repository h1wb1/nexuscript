        drawSvgIcon = function(parent, name)
            local container = create("Frame", { Name = name .. "SvgIcon", Position = UDim2.fromOffset(7, 4),
                Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, BorderSizePixel = 0 }, parent)
            local pool, color = {}, Theme.Muted
            local lastPixels, lastScale
            local function layout(effectiveScale)
                effectiveScale = math.max(0.1, effectiveScale)
                local pixels = 24 -- Stable source grid; UIScale scales the complete silhouette.
                if lastPixels == pixels then return end
                lastPixels, lastScale = pixels, effectiveScale
                container.Size = UDim2.fromOffset(24, 24)
                local mask = (masks[name] or masks.Legit)[pixels]
                local count = #mask / 5
                for i = 1, count do
                    local x, y, width, height, alpha = mask:byte((i - 1) * 5 + 1, i * 5)
                    x, y, width, height, alpha = x - 35, y - 35, width - 35, height - 35, alpha - 35
                    local pixel = pool[i]
                    if not pixel then
                        pixel = create("Frame", { Name = "IconCoverage", BorderSizePixel = 0,
                            BackgroundColor3 = color, Active = false }, container)
                        -- Icon opacity belongs to the SVG, not the menu-background slider.
                        extras.ThemeBindings[pixel] = nil
                        pool[i] = pixel
                    end
                    -- UDim.Offset is integral: 1 / 1.3 becomes zero there.
                    -- Keep integral source coordinates; the ancestor UIScale handles all scaling.
                    pixel.Position = UDim2.fromOffset(x, y)
                    pixel.Size = UDim2.fromOffset(width, height)
                    pixel.BackgroundColor3, pixel.BackgroundTransparency = color, 1 - alpha / 15
                    pixel.Visible = true
                end
                for i = count + 1, #pool do pool[i].Visible = false end
            end
            table.insert(layouts, layout)
            layout(uiScale.Scale)
            return function(value)
                color = value
                for _, pixel in ipairs(pool) do pixel.BackgroundColor3 = color end
            end
        end
    end

