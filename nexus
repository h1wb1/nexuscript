    local function makePage(name, number, subtitle)
        local group = create("CanvasGroup", { Name = name, Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1, Visible = false, GroupTransparency = 1 }, pageHost)
        local columns = {}
        for index, key in ipairs({ "left", "right" }) do
