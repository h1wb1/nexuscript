    -- Исходные свойства сохраняются отдельно для каждого нового Humanoid.
    -- Восстанавливаем только то значение, которое всё ещё принадлежит нам:
    -- стороннее изменение сервером/игрой при выключении не затирается.
    local function restoreOne(humanoid, saved, speed, jump)
        if not humanoid.Parent then return end
        if speed and saved.lastSpeed ~= nil then
            if humanoid.WalkSpeed == saved.lastSpeed then humanoid.WalkSpeed = saved.speed end
            saved.lastSpeed = nil
        end
        if jump and saved.lastJump ~= nil then
            local ownsPower = humanoid.JumpPower == saved.lastJump
            if ownsPower then humanoid.JumpPower = saved.jump end
            if ownsPower and humanoid.UseJumpPower then humanoid.UseJumpPower = saved.usePower end
            saved.lastJump = nil
        end
    end
    restoreMovement = function()
        for humanoid, saved in pairs(movementOriginals) do
            protected("restore-movement", restoreOne, humanoid, saved, true, true)
        end
    end
    local function applyMovement()
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end
        local saved = movementOriginals[humanoid]
        if not saved then
            saved = {}
            movementOriginals[humanoid] = saved
        end
        if Settings.SpeedEnabled then
            if saved.lastSpeed == nil then saved.speed = humanoid.WalkSpeed end
            saved.lastSpeed = Settings.WalkSpeed
            humanoid.WalkSpeed = Settings.WalkSpeed
        else
            restoreOne(humanoid, saved, true, false)
        end
        if Settings.JumpEnabled then
            if saved.lastJump == nil then
                saved.jump, saved.usePower = humanoid.JumpPower, humanoid.UseJumpPower
            end
            saved.lastJump = Settings.JumpPower
            humanoid.UseJumpPower = true
            humanoid.JumpPower = Settings.JumpPower
        else
            restoreOne(humanoid, saved, false, true)
        end
    end
