    local restoreHitboxes = function() end
    local stopFreecam = function() end
    local restoreChams = function() end
    local restoreWorld = function() end
    local stopWeather = function() end
    local stopMotion = function() end
    local stopEnvironment = function() end

    -- Ошибки видны в консоли, но одинаковые сообщения не спамят каждый кадр.
    local function protected(label, callback, ...)
        local results = table.pack(pcall(callback, ...))
        if not results[1] then
            local now = os.clock()
            if not warningTimes[label] or now - warningTimes[label] > 8 then
                warningTimes[label] = now
                warn("[Nexus / " .. label .. "] " .. tostring(results[2]))
            end
        end
        return table.unpack(results, 1, results.n)
    end

    local function connect(signal, label, callback)
        local connection = signal:Connect(function(...)
            if alive then protected(label, callback, ...) end
        end)
        table.insert(connections, connection)
        return connection
    end

    -- Регистрация корневых объектов обеспечивает очистку даже при сбое сборки UI.
    local function own(instance)
        table.insert(owned, instance)
        return instance
    end

    local function destroy()
        if not alive then return end
        alive = false
        if renderBound then
            pcall(function() RunService:UnbindFromRenderStep(renderName) end)
            pcall(function() RunService:UnbindFromRenderStep(renderName .. "_ESP") end)
        end
        for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
        for _, tween in pairs(activeTweens) do pcall(function() tween:Cancel() end) end
        pcall(restoreMovement)
        pcall(restoreHitboxes)
        pcall(stopFreecam)
        pcall(restoreChams)
        pcall(stopEnvironment)
        pcall(restoreWorld)
        pcall(stopWeather)
        pcall(stopMotion)
        for _, instance in ipairs(owned) do pcall(function() instance:Destroy() end) end
        if environment[sessionKey] == controller then environment[sessionKey] = nil end
        table.clear(connections)
        table.clear(records)
    end
    emergencyCleanup = destroy
    controller.Destroy = destroy

