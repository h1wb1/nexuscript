                CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollingDirection = Enum.ScrollingDirection.Y,
            }, group)
            create("UIPadding", { PaddingRight = UDim.new(0, 5), PaddingBottom = UDim.new(0, 12) }, scroller)
            create("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }, scroller)
            columns[key] = scroller
        end
        local tab = button(sidebar, "", UDim2.fromOffset(10, 116 + pageOrder * 39),
            UDim2.fromOffset(140, 32), Theme.Sidebar)
        corner(tab, 4)
        tab.TextSize, tab.TextColor3, tab.TextXAlignment = 12, Theme.Muted, Enum.TextXAlignment.Left
        local title = text(tab, name, UDim2.fromOffset(40, 0), UDim2.new(1, -45, 1, 0), 12, Theme.Muted)
        title.Name = "TabTitle"
        tabIconColors[name] = drawSvgIcon(tab, name)
        pageOrder = pageOrder + 1
        pages[name], tabButtons[name] = group, tab
        connect(tab.Activated, "tab-" .. name, function()
            if selectedPage == name then return end
            selectedPage = name
            breadcrumb.Text = "Overview  /  " .. name
            for pageName, page in pairs(pages) do
                page.Visible = pageName == name
                if page.Visible then page.GroupTransparency = 1; tween(page, { GroupTransparency = 0 }, 0.16) end
                tween(tabButtons[pageName], {
                    BackgroundColor3 = pageName == name and Theme.Hover or Theme.Sidebar,
                    TextColor3 = pageName == name and Theme.Text or Theme.Muted,
                })
                tabIconColors[pageName](pageName == name and Theme.Accent or Theme.Muted)
                tabButtons[pageName]:FindFirstChild("TabTitle").TextColor3 = pageName == name and Theme.Text or Theme.Muted
            end
        end)
        return columns
    end
