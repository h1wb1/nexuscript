    -- Capture semantic theme roles at construction, never recolor by current pixel values.
    extras.ThemeBindings = setmetatable({}, { __mode = "k" })
    extras.BindTheme = function(object, property, token)
        local binding = extras.ThemeBindings[object]
        if not binding then binding = { colors = {} }; extras.ThemeBindings[object] = binding end
        binding.colors[property] = token
    end
    local function create(className, properties, parent)
        local object = Instance.new(className)
        for property, value in pairs(properties or {}) do
            object[property] = value
            if typeof(value) == "Color3" and (property == "BackgroundColor3" or property == "TextColor3"
                or property == "ScrollBarImageColor3" or property == "Color") then
                for _, token in ipairs({ "Background", "Sidebar", "Card", "Hover", "Line", "Text", "Muted", "Accent", "DarkAccent", "Red" }) do
                    local color = Theme[token]
                    if value.R == color.R and value.G == color.G and value.B == color.B then
                        extras.BindTheme(object, property, token); break
                    end
                end
            end
        end
        object.Parent = parent
        return object
    end
    local function corner(object, radius)
        create("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object)
    end
    local function stroke(object, color, thickness)
        return create("UIStroke", {
            Color = color or Theme.Line, Thickness = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, object)
    end
    local function text(parent, value, position, size, fontSize, color, bold)
